<?xml version="1.0" encoding="utf-8"?>
<!-- The single-game wrapper reads the game package through the system file picker and keeps the game
     in its own storage, so it never needs broad storage access. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:node="remove" />
</manifest>
